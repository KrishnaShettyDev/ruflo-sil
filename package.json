{
  "name": "@plutaslab/ruflo-sil",
  "version": "0.1.0",
  "description": "Semantic Intent Layer plugin for ruflo — detect intent corruption in AI-mediated writing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./detectors": "./dist/detectors/index.js",
    "./scorers": "./dist/scorers/index.js",
    "./mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "bench": "tsx benchmark/scripts/run-bench.ts",
    "mcp:dev": "tsx src/mcp/server.ts",
    "demo": "tsx examples/demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "zod": "^3.23.0",
    "ioredis": "^5.4.0",
    "p-queue": "^8.0.0",
    "lru-cache": "^11.0.0",
    "openai": "^4.70.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
